/**
 * list_browser.jst (javascript)
 *
 * Unified list browser (replaces gallery + destinations-overview). Driven by URL
 * query parameters:
 *   ?dataset=<id>   one of the `id`s in datasets.json -> its file/title/options
 *   ?view=<mode>    table | grid
 *   ?keywords= ?badges= ?access= ?search=   the filters
 *
 * The URL is the whole state: every control commits by navigating to a new one
 * (see navigate()), so the page re-renders from scratch and Back/Forward work.
 *
 * This script registers ONE block renderer and nothing else runs on load —
 * the same shape as lakes.jst. The page HTML is a single element:
 *
 *   <div data-block-type="list_browser"></div>
 *
 * The renderer creates the two divs it fills (controls, then the rendered
 * dataset) inside that element, so the markup carries no structure the
 * renderer depends on finding.
 *
 * Registering instead of executing is also what makes the load order safe.
 * This file is a plain <script src> in the page body, so it EXECUTES before
 * gl-constants.jst and gettinglost.jst (both in the Footer template) — but
 * the renderer is only CALLED from renderBlocks(), long after both have run,
 * so window.GL is fully populated by then.
 *
 * Rendering a page is FOUR PHASES, in order, read top to bottom in the renderer:
 *   1. PARAMS   — the raw query string becomes what the page acts on
 *   2. LOAD     — datasets.json, then the selected dataset's file. Sequential
 *                 because the first names the second, and if either fails there
 *                 is nothing useful to do, so there is ONE error path.
 *   3. PROCESS  — all of it, up front: filter the rows, pick up the keyword
 *                 vocabulary. Nothing is gained by sequencing work between the
 *                 display calls.
 *   4. DISPLAY  — displayOptionsRow() and displayDataset(), two different views
 *                 on "all that is known".
 *
 * Phases 1-3 build ONE property bag, `known`, a local of the renderer passed to
 * everything below it:
 *   phase 1 adds  params
 *   phase 2 adds  datasetList, dataset, rawRows
 *   phase 3 adds  filteredRows, keywords
 *
 * `known` holds KNOWLEDGE, never DOM. The block element is a plain local of the
 * renderer, which is the only place the page gets touched.
 *
 * **Phases 1-3 WRITE the bag; phase 4 only READS it** — and the display functions
 * are pure `known -> DOM node`, so they cannot affect each other or the page at
 * all. That independence is what the rule is FOR: hand them the element instead
 * and the options row has to run before the dataset or it lands underneath it,
 * which is the same hidden ordering the phases exist to remove. Every display
 * function takes the same argument and opens by naming what it needs out of it;
 * that is what documents its dependencies, rather than an argument list.
 *
 * Why a bag and not explicit arguments: the controls are parallel siblings with
 * drastically different needs (the view toggle wants one parameter, the keyword
 * dropdown wants the derived vocabulary). Any signature serving all of them
 * would just be the union of everyone's needs.
 *
 * Steps 2 and 3 are the same idea twice: walk a list, switch on each element,
 * do the thing you know how to do with it, silently ignore the rest. Their
 * switches are deliberately NOT the same vocabulary — one option can produce
 * several query parameters, or none at all (`view` filters AND displays).
 * A token with no builder, or a parameter with no filter, is a legitimate
 * state (staged rollout, testing, retired-but-kept), never an error.
 *
 * Both renderers are pure (rows -> DOM node): the publish rule that used to
 * live inside renderGrid is now filterView, so what the count says and what
 * you see cannot disagree.
 *
 * The table logic (COLUMNS + fillDataCell + helpers) is ported from
 * destinations-overview.jst, flattened (no groups / no <details>). That page is
 * being retired; this is the code's final home.
 */
(function () {
  "use strict";

  // The shared registry, created defensively: this file may execute before OR
  // after the script that defines it (gettinglost.jst), so it never assumes.
  window.GL = window.GL || {};
  window.GL.blockRenderers = window.GL.blockRenderers || {};

  var UPLOADS = "/wp-content/uploads/";
  var DATASETS_URL = UPLOADS + "datasets.json";
  var VALID_VIEWS = ["table", "grid"];

  // Defaults for a bare URL (no params). A present-but-invalid value is NOT
  // defaulted over — it falls through to the graceful "unknown …" handling.
  var DEFAULT_DATASET = "destinations";
  var DEFAULT_VIEW = "grid";

  // Severity ramp for the access threshold, easiest -> hardest. The access
  // <select> is built from the same array, so the control and the filter cannot
  // drift apart. Read through a function, not a top-level constant, because
  // nothing in this file may touch window.GL at execute time — see the header.
  function roadOrder() {
    return Object.keys(window.GL.ROAD_COLORS);
  }

  // NOTHING at module scope holds page state. The renderer at the bottom builds
  // one `known` bag and passes it down; that is the only way anything here gets
  // at the params, the rows, or the element being rendered into.

  // One fetch path for both files. The URL is in every failure message because
  // "HTTP 404" on its own never says WHICH file was missing — and the two files
  // fail for very different reasons (a bad dataset id vs. a missing data file).
  function fetchJson(url) {
    return fetch(url)
      .catch(function () {
        throw new Error("could not reach " + url);
      })
      .then(function (res) {
        if (!res.ok) {
          throw new Error("failed to load " + url + " (HTTP " + res.status + ")");
        }
        return res.json().catch(function () {
          throw new Error("failed to parse " + url + " (not valid JSON)");
        });
      });
  }

  // The datasets.json entry for the requested id, or a throw. Throwing keeps the
  // caller to one statement — the whole not-found case lives here instead of a
  // branch interrupting the flow of the phases, and the renderer's single catch
  // is already the place that reports a failure.
  function pickDataset(known) {
    // What I need from what is known
    var datasetList = known.datasetList;
    var id = known.params.get("dataset");

    var entry = datasetList.filter(function (d) { return d.id === id; })[0];
    if (entry) return entry;
    throw new Error("Unknown dataset " + id);
  }

  // The ONE place the raw query string becomes what the page acts on. Today it
  // only fills in the defaults; it is also where any parameter validation would
  // go, so nothing downstream has to defend itself.
  //
  // Everything reads the result — filters, controls, and navigate(). One side
  // effect, accepted deliberately: because navigate() patches this object, a
  // default it filled in lands in the next URL. That matches what the site's
  // nav menu already emits (every menu link carries an explicit view=grid), and
  // it makes a shared link say exactly what it will render instead of inheriting
  // whatever the default happens to be later.
  function processParams(search) {
    var p = new URLSearchParams(search);
    if (!p.get("dataset")) p.set("dataset", DEFAULT_DATASET);
    if (!p.get("view")) p.set("view", DEFAULT_VIEW);
    return p;
  }

  // ---- table columns --------------------------------------------------------

  // `align` is optional and means text-align on the whole column, heading
  // included; buildCell applies it. Left is the default and is not written out.
  var COLUMNS = [
    { label: "Name", field: "name", width: 170 },
    { label: "On lost", field: "on_lost", width: 60, align: "center" },
    { label: "Location", field: "location", width: 155 },
    { label: "Distance", field: "haversine", width: 85, align: "center" },
    { label: "Access", field: "roadBadge", width: 75, align: "center" },
    { label: "Sites", field: "siteCount", width: 55, align: "center" },
    { label: "Maps", field: "maps", width: 100, align: "center" },
    { label: "Amenities", field: "amenities", width: 175 },
    { label: "Reservation", field: "reservation" }
  ];

  // ---- table cell helpers (ported from destinations-overview.jst) -----------

  function homepageUrl(place) {
    var links = place.links || [];
    for (var i = 0; i < links.length; i++) {
      if (links[i] && links[i].label === "HomePage") return links[i].url;
    }
    return null;
  }

  // Split campground.links into map links vs reservation entries. Maps are
  // labelled "…map"; everything else is a reservation entry.
  function campgroundLinks(place) {
    var links = (place.campground || {}).links || [];
    var maps = [], reservation = [];
    for (var i = 0; i < links.length; i++) {
      var l = links[i] || {};
      (/map/i.test(l.label || "") ? maps : reservation).push(l);
    }
    return { maps: maps, reservation: reservation };
  }

  // Sum of the columns that HAVE a fixed width (the flexible last column has
  // none and is excluded on purpose). Informational only — the table is 100%
  // wide; this just says how much horizontal room the sized columns want, for
  // tuning the div's max-width and column widths.
  function totalWidth() {
    return COLUMNS.reduce(function (sum, col) { return sum + (col.width || 0); }, 0);
  }

  function isPublished(place) {
    return !!(place.wpSettings && place.wpSettings.published === true);
  }

  function campbellRiverKm(place) {
    var access = place.access || {};
    var list = access.haversine || [];
    for (var i = 0; i < list.length; i++) {
      if (list[i] && list[i].town === "Campbell River") return list[i].km;
    }
    return null;
  }

  // Missing values render as an empty cell; arrays join with ", ".
  function cellText(value) {
    if (value === null || value === undefined || value === "") return "";
    if (Array.isArray(value)) return value.join(", ");
    return String(value);
  }

  // The one place a cell's presentation is decided, for both <th> and <td>. A
  // column's `align` lands here rather than in buildColGroup because a <col>
  // honours only width, border, background and visibility — text-align set there
  // does nothing. Applied last so it beats the header default, which keeps a
  // centered column's heading centered over it.
  function buildCell(tag, col) {
    var cell = document.createElement(tag);
    cell.style.border = "1px solid #ddd";
    cell.style.padding = "0.3rem 0.6rem";
    cell.style.verticalAlign = "top";
    cell.style.fontSize = "0.9rem";
    cell.style.overflowWrap = "break-word";
    cell.style.wordWrap = "break-word";
    if (tag === "th") {
      cell.style.textAlign = "left";
      cell.style.fontWeight = "700";
    }
    if (col && col.align) cell.style.textAlign = col.align;
    return cell;
  }

  // Internal link (github filename -> slug via shared GL.fileToSlug), same tab.
  function internalLink(file, text, tip) {
    var a = document.createElement("a");
    a.href = "/" + window.GL.fileToSlug(file) + "/";
    a.textContent = text;
    if (tip) a.title = tip;
    return a;
  }

  // External link — new tab, safe rel.
  function externalLink(url, text, tip) {
    var a = document.createElement("a");
    a.href = url;
    a.target = "_blank";
    a.rel = "noopener noreferrer";
    a.textContent = text;
    if (tip) a.title = tip;
    return a;
  }

  // Renders a list of { label, url } into a cell, one per line, linked when it
  // has a url. `fallback` is the display text for a url with no label.
  function fillLinkList(cell, entries, tip, fallback) {
    (entries || []).forEach(function (entry, i) {
      var text = cellText(entry.label) || fallback || "";
      if (i > 0) cell.appendChild(document.createElement("br"));
      if (entry.url && text) {
        cell.appendChild(externalLink(entry.url, text, tip));
      } else {
        cell.appendChild(document.createTextNode(text));
      }
    });
  }

  // Fills one column of one place. Per-column link behaviors mirror the overview.
  function fillDataCell(cell, place, field) {
    if (field === "name") {
      var home = homepageUrl(place);
      if (home) {
        cell.appendChild(externalLink(home, cellText(place.name), "Open the destination's web site"));
      } else {
        cell.textContent = cellText(place.name);
      }
    } else if (field === "on_lost") {
      if (place.file && isPublished(place)) {
        cell.appendChild(internalLink(place.file, "View", "Open the page on this web site"));
      }
    } else if (field === "location") {
      var loc = place.location || {};
      var notes = cellText(loc.notes);
      if (loc.lat != null && loc.lng != null && notes) {
        cell.appendChild(externalLink(
          "https://www.google.com/maps/search/?api=1&query=" + loc.lat + "," + loc.lng,
          notes,
          "Open in Google Maps"
        ));
      } else {
        cell.textContent = notes;
      }
    } else if (field === "haversine") {
      var km = campbellRiverKm(place);
      if (km !== null && km !== undefined) cell.textContent = km + " km";
    } else if (field === "roadBadge") {
      var badge = window.GL.deriveRoadBadge(place.access);
      if (badge) cell.textContent = badge.replace(/_/g, " ");
    } else if (field === "siteCount") {
      var n = (place.campground || {}).siteCount;
      if (n !== null && n !== undefined) cell.textContent = String(n);
    } else if (field === "maps") {
      fillLinkList(cell, campgroundLinks(place).maps, "Open the map", "Map");
    } else if (field === "amenities") {
      cell.textContent = cellText((place.campground || {}).amenities);
    } else if (field === "reservation") {
      fillLinkList(cell, campgroundLinks(place).reservation, "Open the reservation web site", null);
    } else {
      cell.textContent = cellText(place[field]);
    }
  }

  function buildColGroup() {
    var colgroup = document.createElement("colgroup");
    COLUMNS.forEach(function (col) {
      var colEl = document.createElement("col");
      colEl.style.width = col.width + "px";
      colgroup.appendChild(colEl);
    });
    return colgroup;
  }

  function appendNoteMarker(cell, number) {
    var sup = document.createElement("sup");
    sup.textContent = String(number);
    sup.style.marginLeft = "1px";
    cell.appendChild(sup);
  }

  function buildFootnotesList(footnotes) {
    var ol = document.createElement("ol");
    ol.style.fontSize = "0.8rem";
    ol.style.color = "#666";
    ol.style.margin = "0.4rem 0 0";
    ol.style.paddingLeft = "1.5rem";
    footnotes.forEach(function (text) {
      var li = document.createElement("li");
      li.textContent = text;
      ol.appendChild(li);
    });
    return ol;
  }

  // ---- the filters ----------------------------------------------------------
  //
  // One function per query parameter, all the same shape:
  //     filterX(value, shortList) -> shortList
  // Each takes its own parameter's value and the list so far, and returns the
  // list narrowed. Chaining them through filterRows() is what produces AND
  // ACROSS controls; OR WITHIN a control is internal to each filter. Adding a
  // filter later is one function plus one line in the switch.

  // A comma-separated parameter value -> array, empties dropped.
  function splitList(value) {
    return (value || "").split(",").filter(Boolean);
  }

  // `view=grid` narrows to published rows: a card advertises a live page.
  function filterView(value, longList) {
    if (value !== "grid") return longList;
    var shortList = longList.filter(isPublished);
    return shortList;
  }

  // Tag membership, OR within the field: keep a row carrying at least one of the
  // wanted values. A row with none of that tag FAILS — badges and keywords are
  // authored claims, and absence is not a match. (Consequence worth knowing: no
  // catalog row carries badges, so any badge filter narrows to the GL pages.)
  function filterByWord(field, wanted, shortList) {
    if (!wanted.length) return shortList;
    return shortList.filter(function (row) {
      var have = (row.tags || {})[field] || [];
      for (var i = 0; i < wanted.length; i++) {
        if (have.indexOf(wanted[i]) !== -1) return true;
      }
      return false;
    });
  }

  function filterKeywords(value, shortList) {
    return filterByWord("keywords", splitList(value), shortList);
  }

  function filterBadges(value, shortList) {
    return filterByWord("badges", splitList(value), shortList);
  }

  // What KIND of place it is. Membership like badges, and absence FAILS for the
  // same reason — which is the point of the facet: an untyped row (a city park,
  // say) answers no type filter at all, so "park" returns provincial parks rather
  // than everything with the word in its name.
  function filterTypes(value, shortList) {
    return filterByWord("types", splitList(value), shortList);
  }

  // Ordinal threshold, not membership: you pick the worst road you will accept,
  // and a row is kept when its derived badge is no worse. UNKNOWN PASSES — only
  // rows with authored legs derive a badge at all, and an unmeasured road is not
  // evidence of a bad one. An unknown threshold value filters nothing.
  function filterAccess(value, shortList) {
    var order = roadOrder();
    var limit = order.indexOf(value);
    if (limit === -1) return shortList;
    return shortList.filter(function (row) {
      var rank = order.indexOf(window.GL.deriveRoadBadge(row.access));
      return rank === -1 || rank <= limit;
    });
  }

  // Free text over the WHOLE row, serialized. Deliberately broad: it sees every
  // field without a list to maintain, at the cost of also seeing keys and URLs
  // (so "map" matches every row carrying a map link). Trade recall for precision
  // later by searching a named field list instead.
  function filterSearch(value, shortList) {
    var needle = (value || "").toLowerCase();
    if (!needle) return shortList;
    return shortList.filter(function (row) {
      return JSON.stringify(row).toLowerCase().indexOf(needle) !== -1;
    });
  }

  // Walk the parameters we are acting on and let each one narrow the list. The
  // loop is driven by the URL, not by the dataset's `options` — a parameter for
  // a control this dataset doesn't show still filters, which is what makes a
  // hand-typed or shared URL work. A key with no case is not an error: it is
  // `dataset`, or a control that doesn't filter, or a filter not built yet.
  function filterRows(known) {
    // What I need from what is known
    var p = known.params;

    var shortList = known.rawRows;
    p.forEach(function (value, key) {
      switch (key) {
        case "view":     shortList = filterView(value, shortList); break;
        case "keywords": shortList = filterKeywords(value, shortList); break;
        case "types":    shortList = filterTypes(value, shortList); break;
        case "badges":   shortList = filterBadges(value, shortList); break;
        case "access":   shortList = filterAccess(value, shortList); break;
        case "search":   shortList = filterSearch(value, shortList); break;
        default: break; // not a filter — see the comment above
      }
    });
    return shortList;
  }

  // ---- renderers: pure (rows -> DOM node) -----------------------------------

  // Card grid — same wrapper + renderCard as gallery.jst, so it inherits the
  // existing card CSS. Renders exactly what it is handed; the published rule is
  // filterView's job now.
  function renderGrid(rows) {
    var grid = document.createElement("div");
    grid.className = "gl-gallery-grid";
    var html = "";
    for (var i = 0; i < rows.length; i++) {
      html += window.GL.renderCard(rows[i]);
    }
    grid.innerHTML = html;
    return grid;
  }

  // The match count, and the empty state at the same time: 0 rows reads
  // "0 of 38 found". Always both numbers, even when nothing is filtered out
  // ("38 of 38 found") — one format at all times, so the readout never changes
  // shape under you as you filter.
  // A readout, not a control, so no pill — it rides at the right end of the
  // options bar (margin-left:auto in CSS). One uniform string in the family brown;
  // see .gl-lb-count in the CSS for size/weight/color.
  function buildCount(n, total) {
    var el = document.createElement("div");
    el.className = "gl-lb-count";
    el.textContent = n + " of " + total + " found";
    return el;
  }

  // One flat table (no groups): colgroup + thead + tbody + numbered footnotes.
  // Renders exactly what it is handed. Per-place footnotes become numbered
  // superscripts on the matching cell, dedup'd into the list below the table.
  function renderTable(rows) {
    var footnotes = [];

    var table = document.createElement("table");
    table.style.borderCollapse = "collapse";
    table.style.width = "100%";
    table.style.tableLayout = "fixed";
    table.style.marginTop = "0.25rem";

    // Informational: how much width the fixed columns want (flexible last
    // column excluded). Handy for tuning column widths and the div max-width.
    console.log("[list_browser] fixed columns total width: " + totalWidth() + "px");

    table.appendChild(buildColGroup());

    var thead = document.createElement("thead");
    var headerRow = document.createElement("tr");
    COLUMNS.forEach(function (col) {
      var th = buildCell("th", col);
      th.textContent = col.label;
      if (col.field === "haversine") {
        var caveat = "Straight-line distance from Campbell River, approximate — not road distance.";
        var idx = footnotes.indexOf(caveat);
        if (idx === -1) { footnotes.push(caveat); idx = footnotes.length - 1; }
        appendNoteMarker(th, idx + 1);
      }
      headerRow.appendChild(th);
    });
    thead.appendChild(headerRow);
    table.appendChild(thead);

    // Source order is authoritative (the dataset file is pre-sorted); render as-is.
    var places = rows;

    var tbody = document.createElement("tbody");
    places.forEach(function (place) {
      var row = document.createElement("tr");
      COLUMNS.forEach(function (col) {
        var cell = buildCell("td", col);
        fillDataCell(cell, place, col.field);
        (place.footnotes || []).forEach(function (fn) {
          if (fn.field !== col.field) return;
          var idx = footnotes.indexOf(fn.text);
          if (idx === -1) { footnotes.push(fn.text); idx = footnotes.length - 1; }
          appendNoteMarker(cell, idx + 1);
        });
        row.appendChild(cell);
      });
      tbody.appendChild(row);
    });
    table.appendChild(tbody);

    // Wrap so a wide table scrolls sideways instead of breaking the page, and
    // BREAK OUT of the theme's ~900px content cap so the wide table has room.
    //
    // The breakout has to be a real one — an explicit width plus negative side
    // margins — not a max-width. Max-width only caps: this div fills its parent
    // (the block element, which the theme constrains), so a larger max-width
    // would never bind and the table would stay boxed at the content width.
    //
    // 1180 - 900 = 280, so -140 a side centers the extra room. `margin-inline`
    // is the horizontal pair by definition (inline-start/end) — it cannot touch
    // the vertical margins, so the table's spacing above and below is untouched.
    //
    // Only the TABLE breaks out. The options row, the count and the footnotes
    // all keep the standard content width — the footnotes because they sit in
    // the outer div below, as a sibling of the breakout rather than inside it.
    var wrap = document.createElement("div");
    wrap.style.width = "1180px";
    wrap.style.marginInline = "-140px";
    wrap.style.overflowX = "auto";
    wrap.appendChild(table);

    var out = document.createElement("div");
    out.appendChild(wrap);
    if (footnotes.length) out.appendChild(buildFootnotesList(footnotes));
    return out;
  }

  // ---- PHASE 4: display ------------------------------------------------------
  //
  // Two views on what is known. Both are PURE — known -> DOM node, same as the
  // renderers below them. They read the bag, never write it, and never touch the
  // page: the renderer does the appending, so the order the two land in is
  // visible at the top level instead of hidden inside them.
  //
  // That purity is the point of the read-only rule, not a side effect of it. An
  // earlier version passed the block element in the bag and let each function
  // append to it — which keeps the letter of "display never writes the bag" while
  // losing the thing it was for, since the options row then has to run before the
  // dataset or it lands underneath it. The element is a local of the renderer.

  // No fetching and no filtering: it is handed the rows and draws them.
  //
  // No per-view width handling here either. The table is the only thing that
  // needs more room than the theme's content width, so it breaks out on its own
  // inside renderTable — nothing outside has to know, and there is no width
  // state to set on one view and clear on the other.
  // Just the table/grid now — the match count moved up into the options bar
  // (buildOptionsBar), so this returns the single rendered node with no wrapper.
  function displayDataset(known) {
    // What I need from what is known
    var rows = known.filteredRows;
    var isGrid = known.params.get("view") === "grid";

    return isGrid ? renderGrid(rows) : renderTable(rows);
  }

  // ---- options bar (controls) -----------------------------------------------
  //
  // Every control has the SAME signature — build(known) -> DOM node, or nothing —
  // and opens by naming what it needs out of the bag. A control that needs two
  // things names two; one that needs nothing names nothing. They are parallel
  // siblings with genuinely different needs, which is exactly why they are handed
  // everything rather than an argument list that is the union of all of them.
  //
  // Controls commit through navigate(known, patch), the one non-display function
  // that also needs the bag: it clones the current params to build the next URL.

  // The single seam every control commits through: clone what the page is acting
  // on, apply the patch, drop empty values (so a cleared filter leaves no param),
  // and move to the new URL. Assigning location.search keeps path and hash and
  // is a real navigation, so Back/Forward restore prior filter states with no
  // extra machinery — the state lives entirely in the URL. Params this control
  // doesn't own (notably `dataset`) survive because we clone rather than rebuild.
  // known.params is never mutated: the patch goes onto a copy.
  function navigate(known, patch) {
    var next = new URLSearchParams(known.params);
    for (var key in patch) {
      var value = patch[key];
      if (value === null || value === undefined || value === "") next.delete(key);
      else next.set(key, value);
    }
    // TESTING — the alert shows the query string being committed, then the
    // navigation actually happens on dismiss. Delete the alert line before this
    // goes live; the assignment below is the real behavior and stays.
      // Keeping the alert on purpose, it may be usefull later for other debugging.
//    window.alert(next.toString());
    location.search = next.toString();
  }

  // Segmented table|grid toggle; the current view carries .is-active. Commits
  // immediately on click — a single unambiguous choice, nothing to accumulate.
  function buildViewToggle(known) {
    // What I need from what is known
    var current = known.params.get("view");

    var wrap = document.createElement("div");
    wrap.className = "gl-lb-view";
    VALID_VIEWS.forEach(function (v) {
      var b = document.createElement("button");
      b.type = "button";
      b.textContent = v;
      if (v === current) b.className = "is-active";
      b.addEventListener("click", function () { navigate(known, { view: v }); });
      wrap.appendChild(b);
    });
    return wrap;
  }

  // One multi-select checkbox dropdown (<details>/<summary> disclosure) over
  // `values`, with the ?<paramName>= values pre-checked. Shared by the keyword and
  // badge filters — they differ only in label, param, and vocabulary. snake_case
  // values show with spaces. An empty vocabulary builds nothing (see below).
  // Each value carries how many rows it would match, from `counts` (sync.js
  // collected them per dataset). A value with no key counts 0 — which happens
  // only in the CLOSED badge vocabulary, where a zero is worth showing: the
  // dropdown is advertising room the data has not used yet.
  // Commits when the panel CLOSES, not per checkbox: navigating on every tick
  // would reload the page and shut the panel, so only one value could ever be
  // picked per visit. `chosen` is the canonical (values-ordered) form of what the
  // URL currently holds, which is what the close handler compares against so a
  // panel opened and closed untouched commits nothing.
  function buildCheckboxDropdown(label, paramName, values, counts, known) {
    // Nothing to pick is not a control. An absent vocabulary and an empty one are
    // the same thing to a reader, so both build nothing.
    if (!values || !values.length) return null;

    // What I need from what is known
    var selected = splitList(known.params.get(paramName));

    var chosen = values.filter(function (v) { return selected.indexOf(v) !== -1; });
    var boxes = [];

    var details = document.createElement("details");
    details.className = "gl-lb-dropdown";

    var summary = document.createElement("summary");
    summary.textContent = chosen.length ? label + " (" + chosen.length + ")" : label;
    details.appendChild(summary);

    var panel = document.createElement("div");
    panel.className = "gl-lb-panel";

    if (!values.length) {
      var none = document.createElement("div");
      none.className = "gl-lb-empty";
      none.textContent = "none in this dataset";
      panel.appendChild(none);
    }

    values.forEach(function (v) {
      var lab = document.createElement("label");
      var cb = document.createElement("input");
      cb.type = "checkbox";
      cb.value = v;
      if (selected.indexOf(v) !== -1) cb.checked = true;
      boxes.push(cb);
      lab.appendChild(cb);
      lab.appendChild(document.createTextNode(v.replace(/_/g, " ") + " (" + (counts[v] || 0) + ")"));
      panel.appendChild(lab);
    });

    // The checked set in `values` order, so it compares cleanly against `chosen`
    // and the emitted param is order-stable no matter what order boxes were hit.
    function checkedValues() {
      return values.filter(function (v, i) { return boxes[i].checked; });
    }

    // `toggle` fires on open too — only the close edge commits.
    details.addEventListener("toggle", function () {
      if (details.open) return;
      var now = checkedValues();
      if (now.join(",") === chosen.join(",")) return;
      chosen = now;
      summary.textContent = chosen.length ? label + " (" + chosen.length + ")" : label;
      var patch = {};
      patch[paramName] = now.join(",");
      navigate(known, patch);
    });

    details.appendChild(panel);
    return details;
  }

  // PHASE 3 step — the keyword vocabulary is PROCESSING, not display. sync.js
  // walks the hydrated rows and writes the per-value counts into the dataset
  // entry; for keywords, which are OPEN, those keys are the vocabulary itself,
  // already sorted. So this reads a finished list rather than deriving one.
  function extractKeywords(known) {
    // What I need from what is known
    var counted = known.dataset.counts.keywords;

    var keywords = Object.keys(counted);
    return keywords;
  }

  // Access filter — a SINGLE-choice threshold over the known, severity-ordered
  // road set (ROAD_COLORS key order: pavement -> ... -> back_country). You pick
  // the WORST road you'll accept; "any" (the default) applies no filter. A plain
  // <select>, not checkboxes — the set is fixed and only one value applies.
  //
  // The count on an option is CUMULATIVE, because that is what the option means:
  // picking "dirt" keeps pavement and unpaved rows too, so the number has to be
  // the running total down the ramp. Unmeasured rows (sync.js counts them under
  // "unknown") pass every threshold, so they seed the total rather than sitting
  // in one option. Accumulating here, not in sync.js, is deliberate: the running
  // total is threshold semantics, and the threshold lives in this file.
  function buildAccessSelect(known) {
    // What I need from what is known
    var current = known.params.get("access") || "";
    var counts = known.dataset.counts.access;

    var sel = document.createElement("select");
    sel.className = "gl-lb-select";

    var any = document.createElement("option");
    any.value = "";
    any.textContent = "Access: any";
    sel.appendChild(any);

    var running = counts.unknown || 0;
    roadOrder().forEach(function (r) {
      running += counts[r] || 0;
      var opt = document.createElement("option");
      opt.value = r;
      opt.textContent = r.replace(/_/g, " ") + " (" + running + ")";
      if (r === current) opt.selected = true;
      sel.appendChild(opt);
    });
    // Commits immediately — one choice, and "any" ("") clears the param.
    sel.addEventListener("change", function () { navigate(known, { access: sel.value }); });
    return sel;
  }

  // Free-text search box; prefilled with the current ?search= value. Commits on
  // losing focus and only when the text actually changed, so tabbing through the
  // bar navigates nothing. `committed` is updated BEFORE navigate() because
  // anything that steals focus (the TESTING alert) can re-enter this handler —
  // the guard has to already be closed by then.
  function buildSearchBox(known) {
    // What I need from what is known
    var current = known.params.get("search") || "";

    var input = document.createElement("input");
    input.type = "text";
    input.className = "gl-lb-search";
    input.placeholder = "Search";
    input.value = current;

    var committed = input.value;
    input.addEventListener("blur", function () {
      var value = input.value.trim();
      if (value === committed) return;
      committed = value;
      navigate(known, { search: value });
    });
    // Enter routes through blur so there is ONE commit path. The input is not in
    // a <form>, so Enter would otherwise do nothing at all.
    input.addEventListener("keydown", function (e) {
      if (e.key === "Enter") input.blur();
    });
    return input;
  }

  // Download link for a dataset's companion booklet PDF, e.g. ?booklet=howto ->
  // /wp-content/uploads/howto.pdf. The parameter names the BOOKLET, not the file;
  // the .pdf and the uploads path are this builder's business.
  //
  // No parameter, NO BUTTON — returning nothing is a normal outcome, the same way
  // the filters read their parameter and apply nothing when it is absent. The
  // dataset's `options` says a booklet is POSSIBLE here; the URL says whether
  // this page has one. That keeps every value in one place: the query string.
  function buildBookletLink(known) {
    // What I need from what is known
    var name = known.params.get("booklet");

    if (!name) return null;
    var a = document.createElement("a");
    a.className = "gl-lb-booklet";
    a.href = UPLOADS + name + ".pdf";
    a.textContent = "Download booklet (PDF)";
    a.setAttribute("download", "");
    return a;
  }

  // Token -> control builder, all sharing one signature: build(known) -> DOM node,
  // or nothing. datasets.json's `options` array names which controls a dataset
  // shows, and in what order; buildOptionsBar walks it through this map.
  var CONTROL_BUILDERS = {
    view: function (known) { return buildViewToggle(known); },
    types: function (known) {
      return buildCheckboxDropdown("Types", "types", window.GL.DESTINATION_TYPES, known.dataset.counts.types, known);
    },
    keywords: function (known) {
      return buildCheckboxDropdown("Keywords", "keywords", known.keywords, known.dataset.counts.keywords, known);
    },
    badges: function (known) {
      return buildCheckboxDropdown("Badges", "badges", Object.keys(window.GL.TAG_COLORS), known.dataset.counts.badges, known);
    },
    access: function (known) { return buildAccessSelect(known); },
    search: function (known) { return buildSearchBox(known); },
    booklet: function (known) { return buildBookletLink(known); }
  };

  // Assemble the bar from the dataset's `options` recipe (order preserved).
  //
  // A token with no builder builds NOTHING, silently — the mirror of the filter
  // switch's default. It is a legitimate state, not an error: a control can be
  // designed before it is built, and a token need not be about controls at all.
  // The two switches are related but not the same vocabulary — one option can
  // emit several query parameters (a shortcut preset) or none (a display mode).
  //
  // A builder may also return NOTHING. `options` says which controls are possible
  // for this dataset; the parameters say what to do about them. Values live in
  // the query string only — a token is a plain name, never "name=value".
  function buildOptionsBar(options, known) {
    var bar = document.createElement("div");
    bar.className = "gl-lb-bar";
    (options || []).forEach(function (token) {
      var build = CONTROL_BUILDERS[token];
      if (!build) return;
      var node = build(known);
      if (node) bar.appendChild(node);
    });
    // The match count rides at the far right (margin-left:auto), appended last so
    // it lands after any booklet control. It is a readout, not a token, so it is
    // not in CONTROL_BUILDERS — it belongs to the bar, on every dataset.
    bar.appendChild(buildCount(known.filteredRows.length, known.rawRows.length));
    return bar;
  }

  // The other half of PHASE 4. The bar IS the options row, so it is returned as
  // it stands — no wrapper div that would exist only for symmetry.
  function displayOptionsRow(known) {
    // What I need from what is known
    var options = known.dataset.options;

    return buildOptionsBar(options, known);
  }

  // ---- the block renderer: the only code in this file that runs -------------
  //
  //   <div data-block-type="list_browser"></div>
  //
  // Takes no attributes and reads no pageData — the whole state is the URL.

  window.GL.blockRenderers.list_browser = function (el) {
    el.innerHTML = "";

    // `known` holds KNOWLEDGE only — no DOM. The appending happens here.
    var known = {};

    // ---- PHASE 1: params ---------------------------------------------------
    known.params = processParams(window.location.search);

    // ---- PHASE 2: load. Sequential — the first file names the second --------
    fetchJson(DATASETS_URL)
      .then(function (datasetList) {
        known.datasetList = datasetList;
        known.dataset = pickDataset(known);

        return fetchJson(UPLOADS + known.dataset.file)
          .then(function (rawRows) {
            known.rawRows = rawRows;

            // ---- PHASE 3: process. All of it, up front ---------------------
            known.filteredRows = filterRows(known);
            known.keywords = extractKeywords(known);

            // ---- PHASE 4: display. READ ONLY from here ---------------------
            el.appendChild(displayOptionsRow(known));
            el.appendChild(displayDataset(known));
          });
      })
      .catch(function (err) {
        console.error("[list_browser] " + err.message, err);
        el.textContent = err.message;
      });
  };
})();
